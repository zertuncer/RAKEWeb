# Sunucu
PORT=3000
HOST=0.0.0.0

# Dashboard girişi (Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=guclu_bir_sifre_yazin

# CORS: tek origin veya virgülle ayrılmış liste, * = hepsi
# Örnek: CORS_ORIGIN=https://rake.example.com
CORS_ORIGIN=*

# MySQL (cPanel > MySQL Databases değerlerini buraya yazın)
# cPanel'de DB/kullanıcı adları genelde şöyle görünür:
#   DB_NAME=cpanelkullanici_rake_db
#   DB_USER=cpanelkullanici_rake
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rake_db
